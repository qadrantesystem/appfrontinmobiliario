    "test:e2": "npx playwright test e2-registrar-edificio",
    "test:e3": "npx playwright test e3-editar-oficina",
    "test:e4": "npx playwright test e4-editar-edificio",
    "test:e5": "npx playwright test e5-busqueda-compartir",
